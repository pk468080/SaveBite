# SaveBite API — example environment. Copy to .env and fill in
# real values through your deployment environment. NEVER commit
# a real .env, and NEVER paste real secrets into the repository
# or into chat. Test-mode Razorpay keys (rzp_test_) only for
# local development and tests.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase (publishable key only is client-facing)
SUPABASE_URL=https://zehnhqcfawagxbactvne.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Server-only deployment secrets — set in the deployment
# environment (Vercel, Render, or your host), never in source code:
# SUPABASE_SERVICE_ROLE_KEY=<server-only, from Supabase dashboard>
# RAZORPAY_WEBHOOK_SECRET=<server-only, from Razorpay webhook settings>

# Production notes (W8):
# - Set ENVIRONMENT=production. That activates the CORS
#   wildcard ban: ALLOWED_ORIGINS must then list the real
#   production website origin, never "*".
# - The notification worker (python -m app.notification_worker)
#   needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY server-side;
#   it is a separate process, not part of the API service.

# Razorpay. key_id is public and may be returned to the frontend.
RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=<server-only, from Razorpay dashboard>

# CORS, comma-separated or JSON list; never "*" in production.
ALLOWED_ORIGINS=http://127.0.0.1:8000
