# Placeholders only — never commit real values here.
# Copy this file to .env.local and fill it in.
# WARNING: never copy the localhost placeholders below to a
# production deployment. All four variables are required;
# since W8, a missing NEXT_PUBLIC_SITE_URL fails loudly
# instead of silently falling back to localhost, which
# used to publish localhost canonicals and localhost
# password-reset links from production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
